# Google Analytics 4 Data API(service account 模式)
# 让程序(我)直接拉 GA4 数据用,不用老板登 Google 后台

# 1) GA4 Property ID(从 GA4 后台 URL 取,/p 后面的数字)
# 例:https://analytics.google.com/analytics/web/#/aXXXXXXXp522345316/  -> 522345316
GA4_PROPERTY_ID=522345316

# 2) Service account JSON 整个内容(从 GCP console 下载的 .json 文件)
# ⚠️ 不要 commit 到 git!Vercel 后台配这个 env,只填 value
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...iam.gserviceaccount.com",...}
